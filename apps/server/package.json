{
  "name": "@collabnote/server",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push --force",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@collabnote/shared": "*",
    "@hocuspocus/server": "^4.8.0",
    "@types/bcrypt": "^6.0.0",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "bcrypt": "^6.0.0",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.4",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "express-session": "^1.19.0",
    "pg": "^8.23.1",
    "ws": "^8.22.2",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cookie-signature": "^1.1.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.19.0",
    "@types/node": "^20.0.0",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.3.2",
    "tsx": "^4.19.0",
    "typescript": "^5.0.0",
    "vitest": "^5.1.0"
  }
